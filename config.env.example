# Copy this to config.env and fill in your values
# cp config.env.example config.env

# ─────────────────────────────────────────────────────────────────────────────
#  LOCAL MODEL  (runs on your VM's CPU via Ollama)
#  Keep it small — a 12GB VM comfortably runs 4B models.
# ─────────────────────────────────────────────────────────────────────────────
# Local models via Ollama are OFF by default — all models run on NVIDIA's
# hosted GPUs. Flip to true only if you also want small CPU models on the VM.
ENABLE_OLLAMA=false
MODEL=nemotron-mini:4b
ENABLE_WEBUI=true

# ─────────────────────────────────────────────────────────────────────────────
#  VM CONNECTION
# ─────────────────────────────────────────────────────────────────────────────
VM_IP=YOUR_VM_IP_HERE
SSH_USER=ubuntu
OLLAMA_PORT=11434
SSH_KEY=~/.ssh/your-oracle-key.pem

# ─────────────────────────────────────────────────────────────────────────────
#  WEB UI ADMIN  (the ChatGPT-like site at http://VM_IP:3000)
#  These auto-create your admin login AND install image generation during
#  `make install` — so there's NO browser setup and nothing to paste.
#  Just log in at the site afterwards with this email + password.
#  Other people can then sign up for their own accounts.
# ─────────────────────────────────────────────────────────────────────────────
# Port the chat site is served on. You MUST open this same port in the Oracle
# Cloud Console (VCN → Security Lists → Ingress). Pick a browser-safe port like
# 3000, 8080, 8000, 8888 — avoid browser-blocked ports (e.g. 6000, 6666, 10080).
WEBUI_PORT=3000
WEBUI_NAME=Admin
WEBUI_EMAIL=you@example.com
WEBUI_PASSWORD=change-me-please

# ─────────────────────────────────────────────────────────────────────────────
#  NVIDIA HOSTED GPU  (build.nvidia.com — free credits, runs the BIG models)
#  Get a key at https://build.nvidia.com  (starts with "nvapi-").
#  Leave NVIDIA_API_KEY blank to disable hosted models entirely.
# ─────────────────────────────────────────────────────────────────────────────
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Big Nemotron model to run on NVIDIA's GPUs (chat / coding / reasoning).
# Default is the flagship 550B reasoning model. Lighter/faster alternatives:
#   nvidia/nemotron-3-super-120b-a12b        (120B, faster)
#   nvidia/llama-3.3-nemotron-super-49b-v1.5 (49B, quick + cheap on credits)
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# ─────────────────────────────────────────────────────────────────────────────
#  IMAGE GENERATION  (NVIDIA hosted GPU — your CPU VM can't do this fast)
#  Uses the same NVIDIA_API_KEY above.
# ─────────────────────────────────────────────────────────────────────────────
# Best quality: flux.1-dev (needs IMAGE_STEPS>=5, we use 50). For fast 4-step
# drafts, set IMAGE_MODEL=black-forest-labs/flux.1-schnell and IMAGE_STEPS=4.
IMAGE_MODEL=black-forest-labs/flux.1-dev
IMAGE_STEPS=50
# Valid sizes: 768 832 896 960 1024 1088 1152 1216 1280 1344 (max 1344x1344)
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
IMAGE_API_URL=https://ai.api.nvidia.com/v1/genai
IMAGE_OUT_DIR=./images

# ─────────────────────────────────────────────────────────────────────────────
#  CLEANUP  (a daily job deletes generated images older than CLEANUP_DAYS)
# ─────────────────────────────────────────────────────────────────────────────
CLEANUP_DAYS=1
